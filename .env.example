# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dfn_discovery_app:password@localhost:5432/dfn_discovery
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=5000

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000

# ─── Identity Provider (DFN Platform IdP) ─────────────────────────────────────
# The issuer URL of the DFN platform IdP. JWKS is fetched from
# {AUTH_ISSUER_URL}/.well-known/jwks.json automatically.
AUTH_ISSUER_URL=https://auth.fabnetwork.com.ng
# The expected 'aud' claim in the JWT. Must match what the IdP issues for Discovery.
AUTH_AUDIENCE=dfn-discovery

# ─── Platform Services ────────────────────────────────────────────────────────
# Base URL of the DFN main platform API (for live quota checks and audit log emission).
DFN_PLATFORM_API_URL=https://api.fabnetwork.com.ng
# Short-lived service token issued by the platform IdP for Discovery → platform calls.
# Must be rotated regularly via secrets manager. Never commit a real value.
DFN_PLATFORM_SERVICE_TOKEN=

# ─── Billing ──────────────────────────────────────────────────────────────────
BILLING_API_URL=https://billing.fabnetwork.com.ng

# ─── Shared Contract Version ──────────────────────────────────────────────────
# The version of @dfn/shared that Discovery expects. Used to validate Prism imports.
SHARED_CONTRACT_VERSION=1.0.0

# ─── Webhook Secrets ──────────────────────────────────────────────────────────
# HMAC secret from SafetyCulture webhook settings.
# Used to verify inbound webhook authenticity before enqueuing.
SAFETYCULTURE_WEBHOOK_SECRET=

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Only one provider is active at a time (AI_PROVIDER controls which).
AI_PROVIDER=openai
AI_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ─── Geo / Logistics ──────────────────────────────────────────────────────────
HERE_API_KEY=
GEOAPIFY_API_KEY=

# ─── Site & Real Estate Integrations ─────────────────────────────────────────
UPKEEP_API_KEY=
SAFETYCULTURE_API_KEY=

# ─── Market Intelligence ──────────────────────────────────────────────────────
# UN Comtrade is public; World Bank is public. Keys only needed if using premium APIs.
COMTRADE_API_KEY=

# ─── Object Storage (Attachments) ────────────────────────────────────────────
ATTACHMENT_BUCKET=dfn-discovery-attachments
ATTACHMENT_SIGNING_KEY=
# Signed URL TTL in seconds. Keep short (≤ 900s = 15 min).
ATTACHMENT_URL_TTL_SECONDS=900

# ─── Worker Configuration ─────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
WORKER_TIMEOUT_MS=30000
