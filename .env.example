# =============================================================================
# DFN DISCOVERY BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================

# Server Port
PORT=4000
NODE_ENV=development

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dfn_discovery
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10

# Redis Connection (BullMQ Queue Workers)
REDIS_URL=redis://localhost:6379

# AI Provider Configuration ('openai' | 'anthropic' | 'google')
AI_PROVIDER=openai
AI_MODEL=gpt-4o

# AI Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Geospatial & Logistics Intelligence (Google Maps Platform API)
# Routes API v2, Routes Matrix, and Geocoding
GOOGLE_MAPS_API_KEY=

# Authentication & Security
JWT_SECRET=your-jwt-secret-key-min-32-chars-change-in-prod
WEBHOOK_HMAC_SECRET=your-webhook-hmac-secret-change-in-prod
